  lines:
  - id: act1_intro_boss_001
    speakerId: "S\u1EBEP"
    text: "S\u1ED1 li\u1EC7u trong file n\xE0y l\xE0 sao?\nNhi\u1EC1u \xF4 c\xF2n
      sai m\xE0 c\u1EADu \u0111\xE3 g\u1EEDi r\u1ED3i \xE0?"
    spokenText: "S\u1ED1 li\u1EC7u trong file n\xE0y l\xE0 sao?\nNhi\u1EC1u \xF4
      c\xF2n sai m\xE0 c\u1EADu \u0111\xE3 g\u1EEDi r\u1ED3i \xE0?"
    fallbackDuration: 7
    postDelay: 0.2
    voiceClip: {fileID: 8300000, guid: d03e491d2f483954b82544167a9cbfd5, type: 3}
    slam: 0
    silentBeat: 0
  - id: act1_intro_boss_002
    speakerId: "S\u1EBEP"
    text: "Kh\xE1ch h\xE0ng \u0111ang ch\u1EDD b\u1EA3n ch\u1ED1t.\nT\xF4i \u0111\xE3
      nh\u1EAFc c\u1EADu t\u1EEB s\xE1ng r\u1ED3i."
    spokenText: "Kh\xE1ch h\xE0ng \u0111ang ch\u1EDD b\u1EA3n ch\u1ED1t.\nT\xF4i
      \u0111\xE3 nh\u1EAFc c\u1EADu t\u1EEB s\xE1ng r\u1ED3i."
    fallbackDuration: 5
    postDelay: 0.2
    voiceClip: {fileID: 8300000, guid: 5ea314f7ec0e55b4d8e39aff3fafa8c7, type: 3}
    slam: 0
    silentBeat: 0
  - id: act1_intro_slam_001
    speakerId: 
    text: 
    spokenText: 
    fallbackDuration: 0.8
    postDelay: 0
    voiceClip: {fileID: 0}
    slam: 1
    silentBeat: 1
  - id: act1_intro_boss_003
    speakerId: "S\u1EBEP"
    text: "Quay v\u1EC1 b\xE0n, ki\u1EC3m tra l\u1EA1i file Excel.\nXong th\xEC in
      m\u1ED9t b\u1EA3n, mang l\u1EA1i \u0111\xE2y cho t\xF4i k\xFD."
    spokenText: "Quay v\u1EC1 b\xE0n, ki\u1EC3m tra l\u1EA1i file Excel.\nXong th\xEC
      in m\u1ED9t b\u1EA3n, mang l\u1EA1i \u0111\xE2y cho t\xF4i k\xFD."
    fallbackDuration: 5
    postDelay: 0.25
    voiceClip: {fileID: 8300000, guid: 8f0e1bd90e160174fb349e443f5c734a, type: 3}
    slam: 0
    silentBeat: 0
  - id: act1_intro_ty_001
    speakerId: "T\xDD"
    text: "D\u1EA1 d\u1EA1 s\u1EBFp, em ki\u1EC3m tra l\u1EA1i ngay \u1EA1"
    spokenText: "D\u1EA1 d\u1EA1 s\u1EBFp, em ki\u1EC3m tra l\u1EA1i ngay \u1EA1"
